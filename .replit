modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 3002

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "scripts/pre-start.sh"]
build = ["bash", "scripts/build-all.sh"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "unit-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "schema-drift"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "playwright-auth"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-links"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "playwright-integration"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Instructional Designer"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "unit-tests"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx vitest run && cd instructional-designer && npx vitest run --config vitest.config.ts"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsc --noEmit"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "schema-drift"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/check-schema-drift.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "playwright-auth"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "CI=1 npx playwright test e2e/sign-in-redirect.spec.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "check-links"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/check-links.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "playwright-integration"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "CI=1 npx playwright test --config instructional-designer/playwright.config.ts instructional-designer/e2e/tools-integration.spec.ts"

[[workflows.workflow]]
name = "Instructional Designer"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd instructional-designer && PORT=3001 npm run dev"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"

[agent]
integrations = ["javascript_anthropic_ai_integrations:2.0.0", "javascript_log_in_with_replit:2.0.0", "github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[userenv]

[userenv.shared]
STATS_API_KEY = "re_7gpkYLFz_Ebv8HJhCyGVRe8q6AMUj7YYX"
ADMIN_USER_IDS = "53962781,vcameron@bridgew.edu"
SUMMARY_EMAIL_TO = "vcameron@bridgew.edu"
SUMMARY_CRON = "0 7 * * *"
VITE_CONVERTER_APP_URL = "https://bsu-accessibility-tool.replit.app"
VITE_ID_APP_URL = "https://bsu-instructional-designer.replit.app"

[userenv.development]
PLAYWRIGHT_TEST = "1"
